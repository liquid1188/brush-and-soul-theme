<section>
  <div class="wrap">
    <div class="sec-head">
      {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="feat-grid">
      {% assign coll = collections[section.settings.collection] %}
      {% for product in coll.products limit: section.settings.count %}
        {% render 'product-card', product: product %}
      {% else %}
        <p style="grid-column:1/-1;text-align:center;color:var(--ink-soft)">Connect a collection in the theme editor to feature work here.</p>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured work",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "fresh from the studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New & featured" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "min": 2, "max": 8, "step": 1, "label": "Items", "default": 4 }
  ],
  "presets": [{ "name": "Featured work" }]
}
{% endschema %}
