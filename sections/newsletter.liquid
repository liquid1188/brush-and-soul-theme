<section class="news">
  <div class="wrap">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>
    <form class="news form" style="display:flex;gap:.7rem;max-width:520px;margin:0 auto;flex-wrap:wrap;justify-content:center" onsubmit="bsSubscribe(event)">
      <input id="bs-name" type="text" placeholder="Your name" aria-label="Your name">
      <input id="bs-email" type="email" placeholder="Your email" aria-label="Email" required>
      <button type="submit" class="btn btn-primary">{{ section.settings.button | default: 'Join' }}</button>
      <span id="bs-status" style="flex-basis:100%;font-size:.9rem;margin-top:.4rem"></span>
    </form>
  </div>
</section>
<script>
  window.BS_SUBSCRIBE_URL = {{ section.settings.subscribe_url | json }};
  function bsSubscribe(e){e.preventDefault();var f=e.target,s=document.getElementById('bs-status');
    var name=document.getElementById('bs-name').value.trim();var email=document.getElementById('bs-email').value.trim();
    if(!window.BS_SUBSCRIBE_URL){s.textContent='Newsletter not configured yet.';return;}
    s.textContent='Joining\u2026';
    fetch(window.BS_SUBSCRIBE_URL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:name,email:email})})
      .then(function(r){if(!r.ok)throw 0;s.textContent="Thank you \u2014 you're on the list.";f.reset();})
      .catch(function(){s.textContent="That didn't go through. Please try again.";});}
</script>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Live a little more beautifully" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "New work, studio notes, and first looks at collections — gently, never often." },
    { "type": "text", "id": "button", "label": "Button", "default": "Join" },
    { "type": "text", "id": "subscribe_url", "label": "Subscribe endpoint URL", "info": "Your Vercel /api/subscribe URL — feeds the Resend audience.", "default": "https://brush-and-soul-subscribe.vercel.app/api/subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
