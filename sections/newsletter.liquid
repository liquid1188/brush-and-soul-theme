<section class="news">
  <div class="wrap">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="news form" style="display:flex;gap:.7rem;max-width:440px;margin:0 auto;flex-wrap:wrap;justify-content:center">
        <input type="email" name="contact[email]" placeholder="Your email" aria-label="Email" required>
        <button type="submit" class="btn btn-primary">{{ section.settings.button | default: 'Join' }}</button>
      </div>
      {% if form.posted_successfully? %}<p style="margin-top:.8rem">Thank you — you're on the list.</p>{% endif %}
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Live a little more beautifully" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "New work, studio notes, and first looks at collections — gently, never often." },
    { "type": "text", "id": "button", "label": "Button", "default": "Join" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
