<section class="news">
  <div class="wrap">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>
    {% form 'customer' %}
      {% if form.posted_successfully? %}
        <p id="bs-status" style="font-size:1rem;margin-top:.6rem">Thank you &mdash; you're on the list.</p>
      {% else %}
      <div class="news form" style="display:flex;gap:.7rem;max-width:520px;margin:0 auto;flex-wrap:wrap;justify-content:center">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="text" name="contact[first_name]" placeholder="Your name" aria-label="Your name">
        <input type="email" name="contact[email]" placeholder="Your email" aria-label="Email" required>
        <button type="submit" class="btn btn-primary">{{ section.settings.button | default: 'Join' }}</button>
        {% if form.errors %}<span id="bs-status" style="flex-basis:100%;font-size:.9rem;margin-top:.4rem;color:var(--pomegranate)">Please enter a valid email.</span>{% endif %}
      </div>
      {% endif %}
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Live a little more beautifully" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "New work, studio notes, and first looks at collections — gently, never often." },
    { "type": "text", "id": "button", "label": "Button", "default": "Join" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
