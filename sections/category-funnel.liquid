{% assign defaults = 'natures-legacy.jpg,into-the-unseen.jpg,city-of-dreams.jpg' | split: ',' %}
<section class="cats">
  <div class="wrap">
    <div class="sec-head">
      {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="cat-grid">
      {% for block in section.blocks %}
        <a class="cat" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <div class="arch">
            {% if block.settings.image %}
              <img class="art-img" src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}">
            {% else %}
              {% assign fb = defaults[forloop.index0] | default: 'natures-legacy.jpg' %}
              <img class="art-img" src="{{ fb | asset_url }}" alt="{{ block.settings.title | escape }}">
            {% endif %}
          </div>
          <h3><span class="dot" style="background:{{ block.settings.color }}"></span>{{ block.settings.title }}</h3>
          <p>{{ block.settings.subtitle }}</p>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Category funnel",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "where would you like to begin?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three ways in" }
  ],
  "blocks": [
    { "type": "category", "name": "Category", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "subtitle", "label": "Subtitle" },
      { "type": "color", "id": "color", "label": "Accent dot", "default": "#A6324A" },
      { "type": "image_picker", "id": "image", "label": "Image (optional)" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Category funnel" }]
}
{% endschema %}
