{%- comment -%} Determine size/option count for the price line {%- endcomment -%}
{%- assign size_option = null -%}
{%- for opt in product.options_with_values -%}
  {%- assign optname = opt.name | downcase -%}
  {%- if optname contains 'size' -%}{%- assign size_option = opt -%}{%- endif -%}
{%- endfor -%}
{%- if size_option -%}
  {%- assign variant_count = size_option.values.size -%}
  {%- assign unit_word = 'sizes' -%}
{%- else -%}
  {%- assign variant_count = product.variants.size -%}
  {%- assign unit_word = 'options' -%}
{%- endif -%}

<section class="pdp">
  <div class="wrap pdp-grid">

    <div class="pdp-gallery">
      <div class="pdp-stage">
        {% if product.featured_image %}
          <img id="pdp-main"
               src="{{ product.featured_image | image_url: width: 1400 }}"
               data-zoom="{{ product.featured_image | image_url: width: 2400 }}"
               alt="{{ product.featured_image.alt | default: product.title | escape }}"
               width="1400" height="1400">
          <span class="pdp-zoom-hint" aria-hidden="true">Click to zoom</span>
        {% else %}
          <div class="ph"><span>artwork</span></div>
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="pdp-thumbs" role="list">
          {% for image in product.images %}
            <button type="button" class="pdp-thumb{% if forloop.first %} is-active{% endif %}"
                    data-full="{{ image | image_url: width: 1400 }}"
                    data-zoom="{{ image | image_url: width: 2400 }}"
                    data-img-id="{{ image.id }}"
                    aria-label="View image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 200 }}"
                   alt="{{ image.alt | default: product.title | escape }}"
                   loading="lazy" width="200" height="200">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="pdp-info">
      {% if product.type != blank %}<span class="tag">{{ product.type }}</span>{% endif %}
      <h1 class="pdp-title">{{ product.title }}</h1>

      <div class="price pdp-price">
        {% if product.has_only_default_variant %}
          {{ product.price | money }}
        {% elsif product.price_varies %}
          {{ variant_count }} {{ unit_word }} &middot; <span class="pdp-from">starting at</span> {{ product.price_min | money }}
        {% else %}
          {{ variant_count }} {{ unit_word }} &middot; {{ product.price | money }}
        {% endif %}
      </div>

      {% render 'promo-badge', product: product, variant: 'pdp' %}

      {% if product.description != blank %}
        {%- assign desc = product.description | replace: '<p>&nbsp;</p>', '' | replace: '<p> </p>', '' | replace: '<p></p>', '' | replace: '<p> </p>', '' -%}
        <div class="prose pdp-desc">{{ desc }}</div>
      {% endif %}

      {% form 'product', product %}
        {% unless product.has_only_default_variant %}
          <div class="field pdp-options">
            <label for="pdp-variant" class="pdp-options-label">{% if size_option %}Size{% else %}Options{% endif %}</label>
            <select id="pdp-variant" name="id" class="shop-sort">
              {% for v in product.variants %}
                <option value="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>
                  {{ v.title }} &mdash; {{ v.price | money }}{% unless v.available %} (sold out){% endunless %}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endunless %}

        <div class="pdp-actions">
          <button type="submit" name="add" class="btn btn-primary" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Add to cart{% else %}Sold out{% endif %}
          </button>
        </div>
      {% endform %}
    </div>

  </div>

  <div id="pdp-lightbox" class="pdp-lightbox" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Zoomed artwork">
    <button type="button" class="pdp-lightbox-close" aria-label="Close">&times;</button>
    <img id="pdp-lightbox-img" src="" alt="{{ product.title | escape }}">
  </div>
</section>

<style>
  .pdp{padding:48px 0}
  .pdp-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
  .pdp-stage{background:var(--mat);border-radius:18px;border:1px solid var(--line);padding:28px;
    display:flex;align-items:center;justify-content:center;min-height:420px}
  .pdp-stage img{max-width:100%;max-height:600px;width:auto;height:auto;display:block;border-radius:3px;
    object-fit:contain;filter:drop-shadow(0 8px 22px rgba(42,27,46,.18))}
  .pdp-stage{position:relative}
  .pdp-stage img{cursor:zoom-in}
  .pdp-zoom-hint{position:absolute;bottom:14px;right:14px;background:rgba(42,27,46,.72);color:#fff;
    font-size:.72rem;font-weight:600;letter-spacing:.02em;padding:.3rem .6rem;border-radius:999px;
    pointer-events:none;opacity:0;transition:opacity .18s}
  .pdp-stage:hover .pdp-zoom-hint{opacity:1}
  .pdp-lightbox{position:fixed;inset:0;z-index:1000;background:rgba(20,12,22,.92);
    display:flex;align-items:center;justify-content:center;padding:4vmin;cursor:zoom-out}
  .pdp-lightbox[hidden]{display:none}
  .pdp-lightbox img{max-width:96vw;max-height:92vh;width:auto;height:auto;border-radius:4px;
    box-shadow:0 12px 50px rgba(0,0,0,.5)}
  .pdp-lightbox-close{position:absolute;top:18px;right:24px;background:none;border:none;color:#fff;
    font-size:2.4rem;line-height:1;cursor:pointer;opacity:.85;padding:.2rem .6rem}
  .pdp-lightbox-close:hover{opacity:1}
  .pdp-thumbs{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
  .pdp-thumb{width:72px;height:72px;padding:4px;border:1px solid var(--line);border-radius:10px;
    background:#fff;cursor:pointer;overflow:hidden;transition:border-color .15s,transform .15s}
  .pdp-thumb img{width:100%;height:100%;object-fit:contain;display:block;border-radius:4px}
  .pdp-thumb.is-active{border-color:var(--lapis)}
  .pdp-thumb:hover{transform:translateY(-1px)}
  .pdp-title{margin:.2rem 0 .5rem;line-height:1.2;overflow-wrap:anywhere}
  .pdp-price{font-size:1.35rem;margin-bottom:.6rem}
  .pdp-promo{display:inline-block;font-size:.85rem;font-weight:600;color:var(--pomegranate);background:rgba(176,58,46,.07);border:1px solid rgba(176,58,46,.22);padding:.32rem .72rem;border-radius:999px;margin-bottom:1.2rem}
  .pdp-promo-note{font-weight:500;opacity:.75}
  .pdp-from{font-weight:500;opacity:.8}
  .pdp-desc{margin:0 0 1.6rem;font-size:1rem}
  .pdp-options{max-width:340px}
  .pdp-options-label{font-weight:700;font-size:.82rem;display:block;margin-bottom:.4rem}
  .pdp-actions{margin-top:1.2rem}
  @media(max-width:760px){
    .pdp{padding:30px 0}
    .pdp-grid{grid-template-columns:1fr;gap:26px}
    .pdp-stage{min-height:0;padding:18px}
    .pdp-stage img{max-height:62vh}
    .pdp-title{font-size:1.5rem}
    .pdp-price{font-size:1.18rem}
  }
</style>

<script>
  (function(){
    var main = document.getElementById('pdp-main');
    if(!main) return;

    // Map each variant to its model-specific image (id + urls)
    var VIMG = { {% for v in product.variants %}{% if v.featured_image %}"{{ v.id }}":{id:"{{ v.featured_image.id }}",f:"{{ v.featured_image | image_url: width: 1400 }}",z:"{{ v.featured_image | image_url: width: 2400 }}"},{% endif %}{% endfor %} };
    // Set of image ids that are some model's featured image (i.e. model-specific shots)
    var pvSel = document.getElementById('pdp-variant');
    var thumbsWrap = document.querySelector('.pdp-thumbs');
    function applyVariant(vid){
      vid = String(vid);
      var info = VIMG[vid];
      if(info){ main.src = info.f; main.setAttribute('data-zoom', info.z); }
      var wantId = info ? String(info.id) : null;
      var thumbs = document.querySelectorAll('.pdp-thumb');
      var visible = 0, exactThumb = null;
      thumbs.forEach(function(t){
        var imgId = (t.getAttribute('data-img-id')||'').trim();
        // If this variant has its own linked image (phone cases), show ONLY that image.
        // If it has none (art prints share one image set), show everything.
        var show = wantId ? (imgId === wantId) : true;
        t.style.display = show ? '' : 'none';
        t.classList.remove('is-active');
        if(show){ visible++; if(imgId===wantId && !exactThumb) exactThumb = t; }
      });
      if(exactThumb) exactThumb.classList.add('is-active');
      // hide the thumbnail strip when there's nothing to switch between
      if(thumbsWrap){ thumbsWrap.style.display = visible > 1 ? '' : 'none'; }
    }
    if(pvSel){ pvSel.addEventListener('change', function(){ applyVariant(this.value); }); applyVariant(pvSel.value); }
    document.querySelectorAll('.pdp-thumb').forEach(function(t){
      t.addEventListener('click', function(){
        var full = t.getAttribute('data-full');
        var zoom = t.getAttribute('data-zoom');
        if(full){ main.src = full; }
        if(zoom){ main.setAttribute('data-zoom', zoom); }
        document.querySelectorAll('.pdp-thumb').forEach(function(x){ x.classList.remove('is-active'); });
        t.classList.add('is-active');
      });
    });
    // Lightbox zoom
    var lb = document.getElementById('pdp-lightbox');
    var lbImg = document.getElementById('pdp-lightbox-img');
    var lbClose = lb ? lb.querySelector('.pdp-lightbox-close') : null;
    function openLB(){
      if(!lb) return;
      lbImg.src = main.getAttribute('data-zoom') || main.src;
      lb.hidden = false; lb.setAttribute('aria-hidden','false');
      document.body.style.overflow = 'hidden';
    }
    function closeLB(){
      if(!lb) return;
      lb.hidden = true; lb.setAttribute('aria-hidden','true');
      lbImg.src = ''; document.body.style.overflow = '';
    }
    main.addEventListener('click', openLB);
    if(lb){ lb.addEventListener('click', closeLB); }
    if(lbClose){ lbClose.addEventListener('click', closeLB); }
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeLB(); });
  })();
</script>
{% schema %}{ "name": "Product", "settings": [] }{% endschema %}
