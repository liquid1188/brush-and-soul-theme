<section class="hero">
  <div class="wrap hero-grid">
    <div>
      {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.subtext != blank %}<p class="lead">{{ section.settings.subtext }}</p>{% endif %}
      <div class="hero-cta">
        <a href="{{ section.settings.button1_url }}" class="btn btn-primary">{{ section.settings.button1_label }}</a>
        <a href="{{ section.settings.button2_url }}" class="btn btn-ghost">{{ section.settings.button2_label }}</a>
      </div>
    </div>
    <div class="hero-art arch fill">
      {% if section.settings.image %}
        <img class="art-img" src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}">
      {% else %}
        <img class="art-img" src="{{ 'persian-hospitality.jpg' | asset_url }}" alt="Artwork by Caroline">
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "color gathered from a life of wandering" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The poetry of life, painted in color." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Pieces born from poetry, rooted in nature — made to fill your space with the richness of a life lived as art." },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "button1_label", "label": "Button 1 label", "default": "Explore the collection" },
    { "type": "url", "id": "button1_url", "label": "Button 1 link" },
    { "type": "text", "id": "button2_label", "label": "Button 2 label", "default": "Commission a piece" },
    { "type": "url", "id": "button2_url", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
