<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">bring a piece home</span>
    <h1>{% if collection.handle == 'all' %}Shop{% else %}{{ collection.title }}{% endif %}</h1>
    {% if collection.description != blank %}<p class="collection-intro">{{ collection.description }}</p>{% endif %}
    {% unless collection.handle == 'all' %}<p class="back-to-shop"><a href="{{ routes.all_products_collection_url }}">&larr; Back to Shop</a></p>{% endunless %}
  </div>
</section>
<section style="padding-top:8px">
  <div class="wrap">
    {% paginate collection.products by 250 %}
      {% if collection.handle == 'all' %}
      <div class="shop-bar" id="shop-bar">
        <div class="shop-search">
          <svg class="shop-search-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M9 3a6 6 0 014.47 10l3.27 3.26-1.42 1.42L12.07 14.4A6 6 0 119 3zm0 2a4 4 0 100 8 4 4 0 000-8z" fill="currentColor"/></svg>
          <input type="search" id="shop-q" placeholder="Search the shop&hellip;" aria-label="Search products" autocomplete="off">
        </div>
        <div class="filter-group cat-toggle">
          <span class="lbl">Browse</span>
          <div class="seg" data-filter="cat">
            <button type="button" class="chip" data-val="all" aria-pressed="true">All</button>
            <button type="button" class="chip" data-val="originals" aria-pressed="false">Originals</button>
            <button type="button" class="chip" data-val="prints" aria-pressed="false">Prints</button>
            <button type="button" class="chip" data-val="products" aria-pressed="false">Products</button>
          </div>
        </div>
        <div class="filter-group">
          <span class="lbl">Price</span>
          <div class="seg" data-filter="price">
            <button type="button" class="chip" data-min="0" data-max="0" aria-pressed="true">All</button>
            <button type="button" class="chip" data-min="0" data-max="2500">Under $25</button>
            <button type="button" class="chip" data-min="2500" data-max="5000">$25&ndash;$50</button>
            <button type="button" class="chip" data-min="5000" data-max="10000">$50&ndash;$100</button>
            <button type="button" class="chip" data-min="10000" data-max="50000">$100&ndash;$500</button>
            <button type="button" class="chip" data-min="50000" data-max="0">Over $500</button>
          </div>
        </div>
        <div class="filter-group">
          <span class="lbl">Sort</span>
          <select class="shop-sort" id="shop-sort">
            <option value="featured">Featured</option>
            <option value="az">Alphabetically, A&ndash;Z</option>
            <option value="za">Alphabetically, Z&ndash;A</option>
            <option value="plow">Price, low to high</option>
            <option value="phigh">Price, high to low</option>
          </select>
        </div>
      </div>
      {% endif %}

      <div class="shop-grid" id="shop-grid">
        {% for product in collection.products %}
          {%- assign cat = 'prints' -%}
          {%- if product.type == 'Original' -%}{%- assign cat = 'originals' -%}{%- elsif product.type == 'Phone Case' -%}{%- assign cat = 'products' -%}{%- endif -%}
          <div class="shop-cell" data-cat="{{ cat }}" data-price="{{ product.price }}" data-title="{{ product.title | downcase | strip_html | escape }}" data-i="{{ forloop.index0 }}">
            {% render 'product-card', product: product %}
          </div>
        {% else %}
          <p class="shop-empty">No pieces here yet &mdash; check back soon.</p>
        {% endfor %}
      </div>
      <p class="shop-empty" id="shop-noresults" hidden>No pieces match. <button type="button" class="linklike" id="shop-clear">Clear filters</button></p>
    {% endpaginate %}
  </div>
</section>

<script>
  (function(){
    var grid = document.getElementById('shop-grid');
    if(!grid) return;
    var cells = Array.prototype.slice.call(grid.querySelectorAll('.shop-cell'));
    if(!cells.length) return;
    var q = document.getElementById('shop-q');
    var sortSel = document.getElementById('shop-sort');
    var noRes = document.getElementById('shop-noresults');
    var state = { cat:'all', min:0, max:0, q:'', sort:'featured' };

    function apply(){
      var qq = state.q.trim().toLowerCase();
      var shown = 0;
      cells.forEach(function(c){
        var okCat = state.cat === 'all' || c.getAttribute('data-cat') === state.cat;
        var price = parseInt(c.getAttribute('data-price'), 10) || 0;
        var okMin = price >= state.min;
        var okMax = state.max === 0 || price < state.max;
        var okQ = !qq || (c.getAttribute('data-title') || '').indexOf(qq) !== -1;
        var show = okCat && okMin && okMax && okQ;
        c.style.display = show ? '' : 'none';
        if(show) shown++;
      });
      if(noRes) noRes.hidden = (shown !== 0);

      var ordered = cells.slice();
      ordered.sort(function(a,b){
        if(state.sort === 'az') return a.getAttribute('data-title').localeCompare(b.getAttribute('data-title'));
        if(state.sort === 'za') return b.getAttribute('data-title').localeCompare(a.getAttribute('data-title'));
        if(state.sort === 'plow' || state.sort === 'phigh'){
          var pa = parseInt(a.getAttribute('data-price'),10)||0, pb = parseInt(b.getAttribute('data-price'),10)||0;
          return state.sort === 'plow' ? pa - pb : pb - pa;
        }
        return (+a.getAttribute('data-i')) - (+b.getAttribute('data-i'));
      });
      ordered.forEach(function(c){ grid.appendChild(c); });
    }

    document.querySelectorAll('.seg[data-filter]').forEach(function(seg){
      seg.addEventListener('click', function(e){
        var btn = e.target.closest('.chip');
        if(!btn) return;
        seg.querySelectorAll('.chip').forEach(function(x){ x.setAttribute('aria-pressed','false'); });
        btn.setAttribute('aria-pressed','true');
        if(seg.getAttribute('data-filter') === 'cat'){ state.cat = btn.getAttribute('data-val'); }
        else { state.min = parseInt(btn.getAttribute('data-min'),10)||0; state.max = parseInt(btn.getAttribute('data-max'),10)||0; }
        apply();
      });
    });
    if(q) q.addEventListener('input', function(){ state.q = this.value; apply(); });
    if(sortSel) sortSel.addEventListener('change', function(){ state.sort = this.value; apply(); });

    var clr = document.getElementById('shop-clear');
    if(clr) clr.addEventListener('click', function(){
      state = { cat:'all', min:0, max:0, q:'', sort:'featured' };
      if(q) q.value = '';
      if(sortSel) sortSel.value = 'featured';
      document.querySelectorAll('.seg[data-filter]').forEach(function(seg){
        seg.querySelectorAll('.chip').forEach(function(x,i){ x.setAttribute('aria-pressed', i===0 ? 'true':'false'); });
      });
      apply();
    });
  })();
</script>
{% schema %}{ "name": "Collection", "settings": [] }{% endschema %}
