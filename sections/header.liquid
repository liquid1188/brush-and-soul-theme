<header>
  <div class="wrap nav">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {% if section.settings.logo %}
        <img src="{{ section.settings.logo | image_url: width: 120 }}" alt="{{ shop.name | escape }}" class="brand-mark" width="40" height="40">
      {% else %}
        <img src="{{ 'logo.jpg' | asset_url }}" alt="{{ shop.name | escape }}" class="brand-mark" width="40" height="40">
      {% endif %}
      <span class="brand-txt">Brush &amp; Soul<small>studio · handmade art</small></span>
    </a>
    <nav aria-label="Primary">
      <ul class="menu">
        {% for link in section.settings.menu.links %}
          <li><a href="{{ link.url }}"{% if link.active %} class="active"{% endif %}>{{ link.title }}</a></li>
        {% else %}
          <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
          <li><a href="{{ routes.root_url }}pages/commissions">Commissions</a></li>
          <li><a href="{{ routes.root_url }}pages/about">About</a></li>
          <li><a href="{{ routes.root_url }}pages/events">Events</a></li>
          <li><a href="{{ routes.root_url }}pages/contact">Contact</a></li>
        {% endfor %}
      </ul>
    </nav>
    <a href="{{ routes.cart_url }}" class="icon-cart" aria-label="Cart">&#8853; {{ cart.item_count }}</a>
  </div>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (defaults to Citrus Leaves)" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu" }
  ]
}
{% endschema %}
