{%- comment -%}
  SEO meta for Brush & Soul Studio.

  Renders title, meta description, Open Graph, Twitter card, and JSON-LD.
  Included from layout/theme.liquid before {{ content_for_header }}.

  Note on the title: page_title arrives HTML-escaped ("Brush &amp; Soul
  Studio") while shop.name is raw, so a `page_title contains shop.name`
  test fails on the home page and appends the shop name twice. This
  branches on template instead.
{%- endcomment -%}

{%- assign shop_name = shop.name -%}
{%- assign fallback_desc = 'Original oil and watercolour paintings, limited-edition prints, and commissioned work by Caroline Likoudis. Brush & Soul Studio.' -%}

{%- comment -%} ---------- title ---------- {%- endcomment -%}
{%- case template.name -%}
  {%- when 'index' -%}
    {%- assign seo_title = shop_name -%}
    {%- assign shop_desc = shop.description | default: '' -%}
    {%- if shop_desc != blank -%}
      {%- assign seo_title = shop_name | append: ' — ' | append: shop_desc -%}
    {%- else -%}
      {%- assign seo_title = shop_name | append: ' — Original Paintings, Prints & Commissions' -%}
    {%- endif -%}
  {%- when '404' -%}
    {%- assign seo_title = 'Page not found — ' | append: shop_name -%}
  {%- else -%}
    {%- assign seo_title = page_title | append: ' — ' | append: shop_name -%}
{%- endcase -%}

{%- comment -%} ---------- description ---------- {%- endcomment -%}
{%- comment -%}
  `| default: ''` normalises nil so the blank test behaves the same way in
  every Liquid implementation; the final `default` fills any remaining gap.
{%- endcomment -%}
{%- assign seo_desc = page_description | default: '' -%}
{%- if seo_desc == blank -%}
  {%- case template.name -%}
    {%- when 'product' -%}
      {%- assign seo_desc = product.description | strip_html | strip_newlines | truncate: 155 | default: '' -%}
    {%- when 'collection' -%}
      {%- assign seo_desc = collection.description | strip_html | strip_newlines | truncate: 155 | default: '' -%}
    {%- when 'article' -%}
      {%- assign seo_desc = article.excerpt_or_content | strip_html | strip_newlines | truncate: 155 | default: '' -%}
    {%- when 'page' -%}
      {%- assign seo_desc = page.content | strip_html | strip_newlines | truncate: 155 | default: '' -%}
  {%- endcase -%}
{%- endif -%}
{%- assign seo_desc = seo_desc | default: fallback_desc -%}
{%- if seo_desc == blank -%}{%- assign seo_desc = fallback_desc -%}{%- endif -%}

{%- comment -%} ---------- share image (absolute URL) ---------- {%- endcomment -%}
{%- if template.name == 'product' and product.featured_image -%}
  {%- assign seo_image = product.featured_image | image_url: width: 1200 -%}
  {%- assign seo_image_alt = product.featured_image.alt | default: product.title -%}
{%- elsif template.name == 'collection' and collection.featured_image -%}
  {%- assign seo_image = collection.featured_image | image_url: width: 1200 -%}
  {%- assign seo_image_alt = collection.title -%}
{%- else -%}
  {%- assign seo_image = 'brand-banner.jpg' | asset_url -%}
  {%- assign seo_image_alt = shop_name -%}
{%- endif -%}
{%- assign seo_image = seo_image | prepend: 'https:' | replace: 'https:https:', 'https:' | replace: 'https:http:', 'http:' -%}

<title>{{ seo_title | escape }}</title>
<meta name="description" content="{{ seo_desc | escape }}">

<meta property="og:site_name" content="{{ shop_name | escape }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% elsif template.name == 'article' %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:description" content="{{ seo_desc | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- comment -%}
  On product pages Shopify's content_for_header already emits og:image with
  width/height, so only supply it elsewhere to avoid duplicate tags.
{%- endcomment -%}
{%- unless template.name == 'product' %}
<meta property="og:image" content="{{ seo_image }}">
<meta property="og:image:alt" content="{{ seo_image_alt | escape }}">
{%- endunless %}
{%- if template.name == 'product' %}
<meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | escape }}">
<meta name="twitter:description" content="{{ seo_desc | escape }}">
<meta name="twitter:image" content="{{ seo_image }}">

{%- comment -%} ---------- JSON-LD ---------- {%- endcomment -%}
{%- if template.name == 'index' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "{{ shop.url }}#organization",
  "name": {{ shop_name | json }},
  "url": "{{ shop.url }}",
  "logo": "{{ 'logo-graphic.png' | asset_url | prepend: 'https:' | replace: 'https:https:', 'https:' }}",
  "description": {{ seo_desc | json }},
  "founder": { "@type": "Person", "name": "Caroline Likoudis" }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": "{{ shop.url }}",
  "name": {{ shop_name | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop.url }}/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- endif %}

{%- if template.name == 'product' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "image": "{{ seo_image }}",
  "description": {{ product.description | strip_html | strip_newlines | truncate: 300 | json }},
  {%- if product.vendor != blank %}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- endif %}
  {%- if product.selected_or_first_available_variant.sku != blank %}
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  {%- endif %}
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "price": "{{ product.price | divided_by: 100.0 }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
  }
}
</script>
{%- endif %}

{%- if template.name == 'collection' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "url": "{{ shop.url }}{{ collection.url }}",
  "description": {{ seo_desc | json }}
}
</script>
{%- endif %}

{%- unless template.name == 'index' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}" },
    { "@type": "ListItem", "position": 2, "name": {{ page_title | strip_html | json }}, "item": "{{ canonical_url }}" }
  ]
}
</script>
{%- endunless %}
