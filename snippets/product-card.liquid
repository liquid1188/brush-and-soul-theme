<a class="card{% if product.images.size <= 1 %} card--single{% endif %}" href="{{ product.url }}">
  <div class="arch card-frame">
    {% if product.featured_image %}
      <img class="art-img art-img--primary" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="800">
      {% if product.images.size > 1 %}
        <img class="art-img art-img--hover" src="{{ product.images[1] | image_url: width: 800 }}" alt="" aria-hidden="true" loading="lazy" width="800" height="800">
      {% endif %}
    {% else %}
      <div class="ph"><span>artwork</span></div>
    {% endif %}
  </div>
  {%- assign title_parts = product.title | split: ' — ' -%}
  {%- assign card_name = title_parts.first -%}
  {%- assign card_sub = '' -%}
  {%- if title_parts.size > 1 -%}{%- assign card_sub = product.title | remove_first: card_name | remove_first: ' — ' -%}{%- endif -%}
  {% if product.type != blank %}<span class="tag">{{ product.type }}</span>{% endif %}
  <h4>{{ card_name }}</h4>
  {% if card_sub != blank %}<span class="card-sub">{{ card_sub }}</span>{% endif %}
  <div class="price">{{ product.price | money }}</div>
  {% render 'promo-badge', product: product, variant: 'card' %}
</a>
