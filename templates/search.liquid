<section class="page-hero"><div class="wrap"><h1>Search</h1>
  <form action="{{ routes.search_url }}" method="get" style="max-width:440px;margin:.8rem auto 0;display:flex;gap:.6rem">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search the studio" style="flex:1;padding:.75rem 1rem;border:1.5px solid var(--line);border-radius:2rem">
    <button class="btn btn-primary">Search</button>
  </form>
</div></section>
<section style="padding-top:10px"><div class="wrap">
  {% if search.performed %}
    <p class="results-meta" style="margin-bottom:20px">{{ search.results_count }} results</p>
    <div class="shop-grid">
      {% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}
    </div>
  {% endif %}
</div></section>
