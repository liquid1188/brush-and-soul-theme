<div class="wrap" style="padding:90px 0;max-width:460px;text-align:center">
  <h1>{{ shop.name }}</h1>
  <p style="color:var(--ink-soft)">Opening soon.</p>
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <div style="display:flex;gap:.6rem;justify-content:center;margin-top:1rem">
      <input type="password" name="password" placeholder="Enter password" aria-label="Password">
      <button type="submit" class="btn btn-primary">Enter</button>
    </div>
  {% endform %}
</div>
