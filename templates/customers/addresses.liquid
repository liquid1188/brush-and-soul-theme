<div class="wrap" style="padding:60px 0;max-width:620px">
  <p><a href="{{ routes.account_url }}">&larr; Account</a></p>
  <h1>Addresses</h1>
  {% for address in customer.addresses %}
    <div style="border:1px solid var(--line);border-radius:14px;padding:16px;margin:12px 0">
      {{ address | format_address }}
    </div>
  {% endfor %}
  <h2 style="margin-top:1.2rem">Add a new address</h2>
  {% form 'customer_address', customer.new_address %}
    {{ form.errors | default_errors }}
    <div class="field"><label>Address</label><input type="text" name="address[address1]"></div>
    <div class="field"><label>City</label><input type="text" name="address[city]"></div>
    <div class="field"><label>Country</label><input type="text" name="address[country]"></div>
    <button type="submit" class="btn btn-primary" style="margin-top:.6rem">Save</button>
  {% endform %}
</div>
