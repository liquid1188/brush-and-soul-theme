<div class="wrap" style="padding:60px 0;max-width:420px">
  <h1>Reset password</h1>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <div class="field"><label>New password</label><input type="password" name="customer[password]" required></div>
    <div class="field"><label>Confirm password</label><input type="password" name="customer[password_confirmation]" required></div>
    <button type="submit" class="btn btn-primary" style="margin-top:.6rem">Reset</button>
  {% endform %}
</div>
