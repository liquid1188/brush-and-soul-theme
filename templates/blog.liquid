<div class="wrap" style="padding:60px 0;max-width:820px">
  <h1>{{ blog.title }}</h1>
  {% paginate blog.articles by 12 %}
    {% for article in blog.articles %}
      <article style="margin:24px 0;border-bottom:1px solid var(--line);padding-bottom:18px">
        <h2 style="margin-bottom:.3rem"><a href="{{ article.url }}">{{ article.title }}</a></h2>
        <p style="color:var(--ink-soft)">{{ article.excerpt_or_content | strip_html | truncatewords: 40 }}</p>
      </article>
    {% else %}
      <p>No posts yet.</p>
    {% endfor %}
    {{ paginate | default_pagination }}
  {% endpaginate %}
</div>
